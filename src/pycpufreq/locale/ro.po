msgid "Error setting sys_set_cpu_max_scaling_freq"
msgstr "Eroare la setarea sys_set_cpu_max_scaling_freq"

msgid "Error setting sys_set_cpu_turbo"
msgstr "Eroare la setarea sys_set_cpu_turbo"

msgid "Manage and monitor CPU frequencies and turbo state."
msgstr "Gestionați și monitorizați frecvențele procesorului și starea turbo."

msgid "Target final CPU scaling frequency (in kHz). If omitted, maximum frequency is used."
msgstr "Frecvența finală țintă de scalare a procesorului (în kHz). Dacă este omisă, se utilizează frecvența maximă."

msgid "Is kernel cpufreq configured?:"
msgstr "Este configurat cpufreq în nucleu?:"

msgid "Invalid frequency: {}. It must be between {} and {} kHz."
msgstr "Frecvență nevalidă: {}. Trebuie să fie între {} și {} kHz."

msgid "Max cpu freq is {}"
msgstr "Frecvența maximă a procesorului este {}"

msgid "Min cpu freq is {}"
msgstr "Frecvența minimă a procesorului este {}"

msgid "Current cpu freq is {}"
msgstr "Frecvența curentă a procesorului este {}"

msgid "Changing cpu to maximum scaling freq"
msgstr "Se schimbă procesorul la frecvența maximă de scalare"

msgid "Current cpu max scaling freq is {}"
msgstr "Frecvența maximă curentă de scalare a procesorului este {}"

msgid "Disabling turbo"
msgstr "Se dezactivează turbo"

msgid "Enabling turbo"
msgstr "Se activează turbo"

msgid "Changing cpu to minimum scaling freq"
msgstr "Se schimbă procesorul la frecvența minimă de scalare"

msgid "Leaving CPU frequency at {}"
msgstr "Se lasă frecvența procesorului la {}"
