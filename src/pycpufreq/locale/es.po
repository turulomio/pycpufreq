msgid "Error setting sys_set_cpu_max_scaling_freq"
msgstr "Error al establecer sys_set_cpu_max_scaling_freq"

msgid "Error setting sys_set_cpu_turbo"
msgstr "Error al establecer sys_set_cpu_turbo"

msgid "Manage and monitor CPU frequencies and turbo state."
msgstr "Gestiona y monitoriza frecuencias de CPU y el estado de Turbo."

msgid "Target final CPU scaling frequency (in kHz). If omitted, maximum frequency is used."
msgstr "Frecuencia final objetivo de escalado de CPU (en kHz). Si se omite, se utiliza la frecuencia máxima."

msgid "Is kernel cpufreq configured?:"
msgstr "¿Está cpufreq del kernel configurado?:"

msgid "Invalid frequency: {}. It must be between {} and {} kHz."
msgstr "Frecuencia no válida: {}. Debe estar entre {} y {} kHz."

msgid "Max cpu freq is {}"
msgstr "La frecuencia máxima de cpu es {}"

msgid "Min cpu freq is {}"
msgstr "La frecuencia mínima de cpu es {}"

msgid "Current cpu freq is {}"
msgstr "La frecuencia actual de cpu es {}"

msgid "Changing cpu to maximum scaling freq"
msgstr "Cambiando la cpu a la frecuencia máxima de escalado"

msgid "Current cpu max scaling freq is {}"
msgstr "La frecuencia máxima actual de escalado de la cpu es {}"

msgid "Disabling turbo"
msgstr "Desactivando turbo"

msgid "Enabling turbo"
msgstr "Activando turbo"

msgid "Changing cpu to minimum scaling freq"
msgstr "Cambiando la cpu a la frecuencia mínima de escalado"

msgid "Leaving CPU frequency at {}"
msgstr "Dejando la frecuencia de CPU en {}"
