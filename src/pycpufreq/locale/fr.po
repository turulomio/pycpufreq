msgid "Error setting sys_set_cpu_max_scaling_freq"
msgstr "Erreur lors de la définition de sys_set_cpu_max_scaling_freq"

msgid "Error setting sys_set_cpu_turbo"
msgstr "Erreur lors de la définition de sys_set_cpu_turbo"

msgid "Manage and monitor CPU frequencies and turbo state."
msgstr "Gérer et surveiller les fréquences du processeur et l'état turbo."

msgid "Target final CPU scaling frequency (in kHz). If omitted, maximum frequency is used."
msgstr "Fréquence finale cible d'échelle du processeur (en kHz). Si omise, la fréquence maximale est utilisée."

msgid "Is kernel cpufreq configured?:"
msgstr "Le cpufreq du noyau est-il configuré ? :"

msgid "Invalid frequency: {}. It must be between {} and {} kHz."
msgstr "Fréquence non valide : {}. Elle doit être comprise entre {} et {} kHz."

msgid "Max cpu freq is {}"
msgstr "La fréquence maximale du processeur est {}"

msgid "Min cpu freq is {}"
msgstr "La fréquence minimale du processeur est {}"

msgid "Current cpu freq is {}"
msgstr "La fréquence actuelle du processeur est {}"

msgid "Changing cpu to maximum scaling freq"
msgstr "Changement du processeur vers la fréquence d'échelle maximale"

msgid "Current cpu max scaling freq is {}"
msgstr "La fréquence d'échelle maximale actuelle du processeur est {}"

msgid "Disabling turbo"
msgstr "Désactivation du turbo"

msgid "Enabling turbo"
msgstr "Activation du turbo"

msgid "Changing cpu to minimum scaling freq"
msgstr "Changement du processeur vers la fréquence d'échelle minimale"

msgid "Leaving CPU frequency at {}"
msgstr "Maintien de la fréquence du processeur à {}"
