msgid "Error setting sys_set_cpu_max_scaling_freq"
msgstr "sys_set_cpu_max_scaling_freq सेट करने में त्रुटि"

msgid "Error setting sys_set_cpu_turbo"
msgstr "sys_set_cpu_turbo सेट करने में त्रुटि"

msgid "Manage and monitor CPU frequencies and turbo state."
msgstr "सीपीयू आवृत्तियों और टर्बो स्थिति का प्रबंधन और निगरानी करें।"

msgid "Target final CPU scaling frequency (in kHz). If omitted, maximum frequency is used."
msgstr "लक्ष्य अंतिम सीपीयू स्केलिंग आवृत्ति (kHz में)। यदि छोड़ दिया जाए, तो अधिकतम आवृत्ति का उपयोग किया जाता है।"

msgid "Is kernel cpufreq configured?:"
msgstr "क्या कर्नेल cpufreq कॉन्फ़िगर किया गया है?:"

msgid "Invalid frequency: {}. It must be between {} and {} kHz."
msgstr "अमान्य आवृत्ति: {}। यह {} और {} kHz के बीच होनी चाहिए।"

msgid "Max cpu freq is {}"
msgstr "अधिकतम सीपीयू आवृत्ति {} है"

msgid "Min cpu freq is {}"
msgstr "न्यूनतम सीपीयू आवृत्ति {} है"

msgid "Current cpu freq is {}"
msgstr "वर्तमान सीपीयू आवृत्ति {} है"

msgid "Changing cpu to maximum scaling freq"
msgstr "सीपीयू को अधिकतम स्केलिंग आवृत्ति में बदला जा रहा है"

msgid "Current cpu max scaling freq is {}"
msgstr "वर्तमान सीपीयू अधिकतम स्केलिंग आवृत्ति {} है"

msgid "Disabling turbo"
msgstr "टर्बो अक्षम किया जा रहा है"

msgid "Enabling turbo"
msgstr "टर्बो सक्षम किया जा रहा है"

msgid "Changing cpu to minimum scaling freq"
msgstr "सीपीयू को न्यूनतम स्केलिंग आवृत्ति में बदला जा रहा है"

msgid "Leaving CPU frequency at {}"
msgstr "सीपीयू आवृत्ति {} पर छोड़ी जा रही है"
