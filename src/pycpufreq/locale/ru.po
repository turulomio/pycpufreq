msgid "Error setting sys_set_cpu_max_scaling_freq"
msgstr "Ошибка при установке sys_set_cpu_max_scaling_freq"

msgid "Error setting sys_set_cpu_turbo"
msgstr "Ошибка при установке sys_set_cpu_turbo"

msgid "Manage and monitor CPU frequencies and turbo state."
msgstr "Управление и мониторинг частот процессора и состояния турбо."

msgid "Target final CPU scaling frequency (in kHz). If omitted, maximum frequency is used."
msgstr "Целевая конечная частота масштабирования процессора (в кГц). Если не указана, используется максимальная частота."

msgid "Is kernel cpufreq configured?:"
msgstr "Настроен ли cpufreq ядра?:"

msgid "Invalid frequency: {}. It must be between {} and {} kHz."
msgstr "Недопустимая частота: {}. Она должна быть в диапазоне от {} до {} кГц."

msgid "Max cpu freq is {}"
msgstr "Максимальная частота процессора: {}"

msgid "Min cpu freq is {}"
msgstr "Минимальная частота процессора: {}"

msgid "Current cpu freq is {}"
msgstr "Текущая частота процессора: {}"

msgid "Changing cpu to maximum scaling freq"
msgstr "Переключение процессора на максимальную частоту масштабирования"

msgid "Current cpu max scaling freq is {}"
msgstr "Текущая максимальная частота масштабирования процессора: {}"

msgid "Disabling turbo"
msgstr "Отключение турбо"

msgid "Enabling turbo"
msgstr "Включение турбо"

msgid "Changing cpu to minimum scaling freq"
msgstr "Переключение процессора на минимальную частоту масштабирования"

msgid "Leaving CPU frequency at {}"
msgstr "Установка частоты процессора на уровне {}"
